    {
      "id": "p7",
      "type": "text",
      "x": 418,
      "y": 191.5,
      "width": 704,
      "height": 150.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1295230044,
      "version": 1,
      "versionNonce": 242640395,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Your job is waiting its turn: the partition is busy, or jobs with higher priority are ahead of it.\n\u2022 See how busy each partition is on the Slurm dashboards in S3DF Grafana.\n\u2022 Ask only for the CPUs, memory, GPUs and --time you need: smaller, shorter jobs fit into gaps\n   sooner.\n\u2022 sprio shows your job's priority. Big job arrays and over-sized requests use up your Repo's\n   fairshare, so its later jobs start lower in the queue.\n\u2022 If the job can be interrupted, --qos preemptable can also use idle nodes owned by other\n   Facilities.",
      "originalText": "Your job is waiting its turn: the partition is busy, or jobs with higher priority are ahead of it.\n\u2022 See how busy each partition is on the Slurm dashboards in S3DF Grafana.\n\u2022 Ask only for the CPUs, memory, GPUs and --time you need: smaller, shorter jobs fit into gaps\n   sooner.\n\u2022 sprio shows your job's priority. Big job arrays and over-sized requests use up your Repo's\n   fairshare, so its later jobs start lower in the queue.\n\u2022 If the job can be interrupted, --qos preemptable can also use idle nodes owned by other\n   Facilities.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "p6",
      "autoResize": true,
      "lineHeight": 1.25
    },
